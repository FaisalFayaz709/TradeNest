# Local development only. Never commit real secrets.
POSTGRES_USER=tradenest
POSTGRES_PASSWORD=tradenest_local_only
POSTGRES_DB=tradenest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tradenest:tradenest_local_only@127.0.0.1:5432/tradenest?schema=public

WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
AI_SERVICE_URL=http://127.0.0.1:8000

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=tradenest-api
JWT_AUDIENCE=tradenest-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# catalog
CATALOG_DEFAULT_CURRENCY=USD

# seller analytics
SELLER_ANALYTICS_LOW_STOCK_THRESHOLD=5

# payment sandbox/provider boundary
CHECKOUT_PAYMENT_TTL_MINUTES=30
CHECKOUT_EXPIRY_SWEEP_SECONDS=60
CHECKOUT_EXPIRY_SWEEP_ENABLED=true
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Payments: optional Stripe hosted Checkout adapter, default remains sandbox
# To enable: PAYMENT_PROVIDER=stripe; use your own Stripe test-mode keys.
# Never commit live keys. URLs must use HTTPS and go back to your TradeNest order page.
# Financial reconciliation: live Stripe charges/refunds remain BLOCKED. Stripe test-mode refunds are
# allowed only from the durable outbox after provider-side verification; sandbox is the default.
# NEEDS_REVIEW operations receive automatic READ-ONLY reconciliation; on uncertainty
# manual intervention is still mandatory. Disable dispatcher for emergency maintenance:
REFUND_RECONCILIATION_ENABLED=true
# Signed inbound Stripe webhooks remain verifiable for already-created provider sessions.
# PAYMENT_STRIPE_SECRET_KEY=sk_test_...
# PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENT_STRIPE_RETURN_ORIGIN=https://your-web.example


# isolated testing (never point these at production/staging data)
TEST_DATABASE_URL=postgresql://tradenest:tradenest_local_only@127.0.0.1:5432/tradenest_test?schema=public
E2E_DATABASE_URL=postgresql://tradenest:tradenest_local_only@127.0.0.1:5432/tradenest_e2e?schema=public
E2E_SHARED_PASSWORD=TradeNest-E2E-Only-2026!
# observability hardening
# Use a deployment secret with at least 32 characters to enable the protected metrics endpoint.
OBSERVABILITY_METRICS_TOKEN=replace-with-at-least-32-random-characters
OBSERVABILITY_SLOW_REQUEST_MS=1000

# Storage: S3-compatible PRIVATE object storage for images and dispute evidence
# For real AWS S3, leave STORAGE_S3_ENDPOINT empty; for local MinIO use http://127.0.0.1:9000.
# Presigned upload endpoints must be reachable by BOTH the browser and NestJS.
STORAGE_S3_BUCKET=tradenest-uploads-test
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
STORAGE_S3_ACCESS_KEY_ID=replace-with-local-storage-user
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-local-storage-secret
