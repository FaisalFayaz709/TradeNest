{
  "name": "tradenest",
  "version": "0.0.0",
  "private": true,
  "description": "TradeNest monorepo \u2014 architecture-locked foundation",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @tradenest/web dev",
    "dev:api": "pnpm --filter @tradenest/api start:dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs -f postgres",
    "infra:reset": "docker compose down -v",
    "db:generate": "pnpm --filter @tradenest/api db:generate",
    "db:validate": "pnpm --filter @tradenest/api db:validate",
    "db:check": "pnpm --filter @tradenest/api db:check",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "db:migrate:deploy": "pnpm --filter @tradenest/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @tradenest/api db:migrate:status",
    "db:foundation:verify": "pnpm --filter @tradenest/api db:foundation:verify",
    "verify:recommendations-ai": "python -m pytest services/ai/tests",
    "verify:smart-pricing-ai": "python -m pytest services/ai/tests/test_pricing.py",
    "verify:fraud-ai": "python -m pytest services/ai/tests/test_fraud.py",
    "verify:improved-recommendations-ai": "python -m pytest services/ai/tests/test_recommendations.py",
    "test:api:unit": "pnpm --filter @tradenest/api test:unit",
    "test:api:integration": "node scripts/run-api-integration.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:ai": "python -m pytest services/ai/tests",
    "test:hardening": "pnpm test:api:unit && pnpm test:api:integration && pnpm test:e2e && pnpm test:ai",
    "deploy:config": "pnpm deploy:preflight && docker compose --env-file infrastructure/docker/deploy.env -f docker-compose.deploy.yml config",
    "deploy:build": "pnpm deploy:preflight && docker compose --env-file infrastructure/docker/deploy.env -f docker-compose.deploy.yml build",
    "deploy:up": "pnpm deploy:preflight && docker compose --env-file infrastructure/docker/deploy.env -f docker-compose.deploy.yml up -d",
    "deploy:down": "docker compose --env-file infrastructure/docker/deploy.env -f docker-compose.deploy.yml down",
    "deploy:validate": "node scripts/validate-deployment-env.mjs",
    "deploy:preflight": "node scripts/deployment-preflight.mjs",
    "deploy:smoke": "node scripts/deployment-smoke.mjs",
    "deploy:acceptance": "pnpm deploy:config && pnpm deploy:build && pnpm deploy:up && pnpm deploy:smoke",
    "verify:foundation:environment": "node scripts/verify-foundation-environment.mjs",
    "acceptance:foundation": "node scripts/accept-foundation.mjs",
    "verify:database": "node scripts/verify-database-migration-chain.mjs",
    "acceptance:database": "node scripts/accept-database.mjs",
    "verify:api-contracts": "node scripts/verify-api-contracts.mjs",
    "test:api-contracts:guards": "node --test scripts/tests/api-contracts-guards.test.mjs",
    "acceptance:api-contracts": "node scripts/accept-api-contracts.mjs",
    "verify:storage": "node scripts/verify-storage.mjs && node --test scripts/tests/storage-guards.test.mjs",
    "acceptance:storage": "node scripts/accept-storage.mjs",
    "verify:checkout": "node scripts/verify-checkout.mjs && node --test scripts/tests/checkout-guards.test.mjs",
    "acceptance:checkout": "node scripts/accept-checkout.mjs",
    "verify:payments": "node scripts/verify-payments.mjs && node --experimental-strip-types --test scripts/tests/payments-gateway-core.test.mjs",
    "acceptance:payments": "node scripts/accept-payments.mjs",
    "verify:financial-remediation": "node scripts/verify-financial-remediation.mjs && node --experimental-strip-types --test scripts/tests/financial-remediation-financial-safety.test.mjs scripts/tests/financial-remediation-ui-structure.test.mjs",
    "acceptance:financial-remediation": "node scripts/accept-financial-remediation.mjs",
    "verify:financial-reconciliation": "node scripts/verify-financial-reconciliation.mjs && node --experimental-strip-types --test scripts/tests/financial-reconciliation-invariants.test.mjs",
    "acceptance:financial-reconciliation": "node scripts/accept-financial-reconciliation.mjs",
    "verify:fulfillment": "node scripts/verify-fulfillment.mjs && node --experimental-strip-types --test scripts/tests/fulfillment-invariants.test.mjs",
    "acceptance:fulfillment": "node scripts/accept-fulfillment.mjs",
    "verify:admin": "node scripts/verify-admin.mjs && node --experimental-strip-types --test scripts/tests/admin-guards.test.mjs",
    "acceptance:admin": "node scripts/accept-admin.mjs",
    "verify:notifications": "node scripts/verify-notifications.mjs && node --test scripts/tests/notifications-notification-guards.test.mjs",
    "acceptance:notifications": "node scripts/accept-notifications.mjs",
    "verify:seller-intelligence": "node scripts/verify-seller-intelligence-ai.mjs && node --experimental-strip-types --test scripts/tests/seller-intelligence-ai-guards.test.mjs",
    "acceptance:seller-intelligence": "node scripts/accept-seller-intelligence.mjs",
    "verify:frontend": "node scripts/verify-frontend.mjs && node --experimental-strip-types --test scripts/tests/frontend-integration.test.mjs",
    "acceptance:frontend": "node scripts/accept-frontend.mjs",
    "verify:payment-compliance": "node scripts/verify-payment-compliance.mjs && node --test scripts/tests/payment-compliance-payment-deployment.test.mjs",
    "acceptance:payment-compliance": "node scripts/accept-payment-compliance.mjs",
    "verify:security": "node scripts/verify-security.mjs && node --experimental-strip-types --test scripts/tests/security-guards.test.mjs",
    "acceptance:security": "node scripts/accept-security.mjs",
    "ops:backup": "node scripts/ops-backup.mjs",
    "ops:restore:drill": "node scripts/ops-restore-drill.mjs",
    "ops:health": "node scripts/ops-health-check.mjs",
    "verify:operations": "node scripts/verify-operations.mjs && node --test scripts/tests/operations.test.mjs",
    "acceptance:operations": "node scripts/accept-operations.mjs"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@10.15.1"
}
