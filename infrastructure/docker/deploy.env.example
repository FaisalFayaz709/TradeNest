# Copy to infrastructure/docker/deploy.env and replace every secret/example value.
# Do not commit the populated deploy.env file.

DEPLOY_BIND_ADDRESS=127.0.0.1
WEB_PUBLISH_PORT=3000
API_PUBLISH_PORT=4000

POSTGRES_USER=tradenest
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=tradenest
DATABASE_URL=postgresql://tradenest:replace-with-a-url-encoded-password@postgres:5432/tradenest?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=tradenest-api
JWT_AUDIENCE=tradenest-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

CATALOG_DEFAULT_CURRENCY=USD
SELLER_ANALYTICS_LOW_STOCK_THRESHOLD=5

PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Optional Stripe TEST mode only. When PAYMENT_PROVIDER=stripe, configure all three.
# No live-money charges or refunds may be enabled before release acceptance.
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_STRIPE_RETURN_ORIGIN=

OBSERVABILITY_METRICS_TOKEN=replace-with-at-least-32-random-characters
OBSERVABILITY_SLOW_REQUEST_MS=1000

# Browser-visible value baked into the Next.js production build.
# Use the externally reachable NestJS API origin/path for the deployment.
NEXT_PUBLIC_API_BASE_URL=https://tradenest.example.com/api/v1

# Storage: S3-compatible PRIVATE object storage for images and dispute evidence
# For real AWS S3, leave STORAGE_S3_ENDPOINT empty; for local MinIO use http://127.0.0.1:9000.
# Presigned upload endpoints must be reachable by BOTH the browser and NestJS.
STORAGE_S3_BUCKET=tradenest-uploads
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=https://storage.example.com
STORAGE_S3_ACCESS_KEY_ID=replace-with-local-storage-user
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-local-storage-secret
