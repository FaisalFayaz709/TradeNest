{
  "name": "@tradenest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm db:generate && pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "pnpm db:generate && pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build",
    "start:dev": "nest start --watch",
    "dev": "pnpm run prestart:dev && pnpm exec nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "pretypecheck": "pnpm db:generate && pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "db:foundation:verify": "tsx scripts/verify-database-foundation.ts",
    "verify:auth": "tsx scripts/verify-auth-runtime.ts",
    "verify:inventory": "tsx scripts/verify-inventory-runtime.ts",
    "verify:cart": "tsx scripts/verify-cart-runtime.ts",
    "verify:checkout-quote": "tsx scripts/verify-checkout-quote-runtime.ts",
    "verify:checkout-transaction": "tsx scripts/verify-transactional-checkout-runtime.ts",
    "verify:single-seller-checkout": "tsx scripts/verify-single-seller-checkout-runtime.ts",
    "verify:payment": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-payment-runtime.ts",
    "verify:payment-db": "tsx scripts/verify-payment-database-runtime.ts",
    "verify:idempotency": "tsx scripts/verify-financial-idempotency-runtime.ts",
    "verify:idempotency-db": "tsx scripts/verify-financial-idempotency-database-runtime.ts",
    "verify:escrow": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-escrow-runtime.ts",
    "verify:escrow-db": "tsx scripts/verify-escrow-database-runtime.ts",
    "verify:orders": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-order-state-machine-runtime.ts",
    "verify:orders-db": "tsx scripts/verify-order-state-machine-database-runtime.ts",
    "verify:shipping": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-shipping-runtime.ts",
    "verify:shipping-db": "tsx scripts/verify-shipping-database-runtime.ts",
    "verify:delivery-confirmation": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-delivery-confirmation-runtime.ts",
    "verify:delivery-confirmation-db": "tsx scripts/verify-delivery-confirmation-database-runtime.ts",
    "verify:cancellation-refund": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-cancellation-refund-runtime.ts",
    "verify:cancellation-refund-db": "tsx scripts/verify-cancellation-refund-database-runtime.ts",
    "verify:disputes": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-disputes-runtime.ts",
    "verify:disputes-db": "tsx scripts/verify-disputes-database-runtime.ts",
    "verify:reviews": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-reviews-runtime.ts",
    "verify:reviews-db": "tsx scripts/verify-reviews-database-runtime.ts",
    "verify:wishlist": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-wishlist-runtime.ts",
    "verify:wishlist-db": "tsx scripts/verify-wishlist-database-runtime.ts",
    "verify:behavior-events": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-behavior-events-runtime.ts",
    "verify:behavior-events-db": "tsx scripts/verify-behavior-events-database-runtime.ts",
    "verify:recommendations": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-recommendations-runtime.ts",
    "verify:seller-analytics": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-seller-analytics-runtime.ts",
    "verify:seller-analytics-db": "tsx scripts/verify-seller-analytics-database-runtime.ts",
    "verify:smart-pricing": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-smart-pricing-runtime.ts",
    "verify:smart-pricing-db": "tsx scripts/verify-smart-pricing-database-runtime.ts",
    "verify:fraud-risk": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-fraud-risk-runtime.ts",
    "verify:fraud-risk-db": "tsx scripts/verify-fraud-risk-database-runtime.ts",
    "verify:improved-recommendations": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-improved-recommendations-runtime.ts",
    "pretest:unit": "pnpm db:generate && pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build",
    "test:unit": "node scripts/run-jest.mjs unit",
    "pretest:integration": "pnpm db:generate && pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build",
    "test:integration": "node scripts/require-test-database.mjs && node scripts/run-jest.mjs integration",
    "e2e:seed": "tsx scripts/seed-e2e-users.ts",
    "verify:audit-hardening": "tsx scripts/verify-audit-hardening-runtime.ts",
    "verify:audit-hardening-db": "tsx scripts/verify-audit-hardening-database-runtime.ts",
    "verify:rate-limiting": "tsx scripts/verify-rate-limiting-runtime.ts",
    "verify:observability": "tsx scripts/verify-observability-runtime.ts",
    "verify:contract-integrity": "pnpm --filter @tradenest/config build && pnpm --filter @tradenest/contracts build && tsx scripts/verify-contract-integrity-runtime.ts",
    "db:database:verify": "tsx scripts/verify-database-integrity.ts",
    "verify:api-contracts:runtime": "tsx scripts/verify-api-contracts-api-runtime.ts",
    "verify:storage:storage": "tsx scripts/verify-storage-storage-runtime.ts",
    "verify:checkout:expiration": "tsx scripts/verify-checkout-expiration-runtime.ts",
    "verify:payments:stripe": "tsx scripts/verify-payments-stripe-runtime.ts",
    "verify:financial-reconciliation:refund-db": "tsx scripts/verify-financial-reconciliation-refund-database-runtime.ts",
    "verify:financial-reconciliation:stripe-refund": "tsx scripts/verify-financial-reconciliation-stripe-refund-runtime.ts",
    "verify:fulfillment:fulfillment-db": "tsx scripts/verify-fulfillment-database-runtime.ts",
    "verify:admin:admin": "tsx scripts/verify-admin-admin-runtime.ts",
    "verify:notifications:notifications": "tsx scripts/verify-notifications-notifications-runtime.ts",
    "verify:seller-intelligence:ai": "tsx scripts/verify-seller-intelligence-ai-runtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tradenest/config": "workspace:*",
    "@tradenest/contracts": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
